# Secrets never belong in this repo - they live in Cloudflare Pages env vars.
.env
.env.*
*.pem
*.key
wrangler.toml.local
.dev.vars

# Local tooling. Nothing in this repo needs dependencies to build or serve.
node_modules/
package-lock.json
package.json

# Scratch space for experiments — per the engineering charter, no stray root files.
scratch/
*.local
*.bak
*.tmp

# Build/verify output
.wrangler/
dist/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
