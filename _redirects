# Cloudflare Pages redirects.
#
# /case-studies held placeholder engagements that were never real work. It is
# deleted, but a 404 lets Cloudflare "Always Online" resurrect an archived copy,
# so the path is redirected instead: a 301 is not an error, leaving nothing for
# Always Online to substitute. Inbound links land on the home page.
/case-studies      /  301
/case-studies.html /  301

# services.html was relabelled "Consulting" when the site stopped leading with
# an agency-style services catalogue.
/services      /collaboration  301
/services.html /collaboration  301

# "Consulting" became "Collaboration" - the page is an invitation to work
# together, not a services catalogue.
/consulting      /collaboration  301
/consulting.html /collaboration  301
